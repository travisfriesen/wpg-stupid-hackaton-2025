{
	"schemaVersion": 1,
	"id": "sixsevenmod",
	"version": "${version}",
	"name": "6-7 Mod",
	"description": "This mod add the 6-7 dimension to Minecraft.",
	"authors": [
		"Jordon",
        "Minh",
        "Travis",
        "GitHub Copilot"
	],
	"contact": {
		"homepage": "https://en.wikipedia.org/wiki/6-7_(meme)"
	},
	"license": "CC0-1.0",
	"icon": "assets/sixsevenmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "ca.travisfriesen.sixsevenmod.SixSevenMod"
		],
		"client": [
          "ca.travisfriesen.sixsevenmod.SixSevenModClient"
		]
	},
	"mixins": [
		"sixsevenmod.mixins.json",
		{
			"config": "sixsevenmod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}